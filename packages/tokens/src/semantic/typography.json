{
  "$description": "Semantic typography roles. Sub-tokens (family/size/weight/line-height/letter-spacing) reference the brand type foundation, so type is brand-specific. Modelled as granular tokens rather than the DTCG composite `typography` type — see trade-off note.",
  "text": {
    "display": {
      "font-family": {
        "$type": "fontFamily",
        "$value": "{brand.font.family.display}"
      },
      "font-size": {
        "$type": "dimension",
        "$value": "{brand.font.scale.4xl}"
      },
      "font-weight": {
        "$type": "fontWeight",
        "$value": "{brand.font.weight.display}"
      },
      "line-height": {
        "$type": "number",
        "$value": "{brand.font.leading.tight}"
      },
      "letter-spacing": {
        "$type": "number",
        "$value": "{brand.font.tracking.tight}",
        "$extensions": {
          "org.mt": {
            "cssUnit": "em",
            "role": "tracking"
          }
        }
      }
    },
