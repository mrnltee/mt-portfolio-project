{
  "$description": "Semantic shape roles — radii reference the brand radius scale (brand-specific); border widths reference primitives.",
  "shape": {
    "radius": {
      "$type": "dimension",
      "control": {
        "$value": "{brand.radius.md}"
      },
      "field": {
        "$value": "{brand.radius.md}"
      },
      "card": {
        "$value": "{brand.radius.lg}"
      },
      "container": {
        "$value": "{brand.radius.xl}"
      },
      "dialog": {
        "$value": "{brand.radius.xl}"
      },
      "pill": {
        "$value": "{brand.radius.full}"
      }
    },
    "border-width": {
      "$type": "dimension",
      "default": {
        "$value": "{border-width.100}"
      },
      "strong": {
        "$value": "{border-width.300}"
      },
      "focus": {
        "$value": "{border-width.300}"
      }
    }
  }
}
