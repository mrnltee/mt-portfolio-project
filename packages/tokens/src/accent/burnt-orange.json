{
  "$description": "Accent overlay 'Burnt orange'. Selected at runtime with <html data-accent=\"burnt-orange\">; re-points ONLY brand.color.accent* (never neutral or feedback). Every overlay must pass the validator's WCAG AA pairs in every brand×theme.",
  "brand": {
    "color": {
      "$type": "color",
      "accent": {
        "50": {
          "$value": "{color.burnt-orange.50}"
        },
        "100": {
          "$value": "{color.burnt-orange.100}"
        },
        "200": {
          "$value": "{color.burnt-orange.200}"
        },
        "300": {
          "$value": "{color.burnt-orange.300}"
        },
        "400": {
          "$value": "{color.burnt-orange.400}"
        },
        "500": {
          "$value": "{color.burnt-orange.500}"
        },
        "600": {
          "$value": "{color.burnt-orange.600}"
        },
        "700": {
          "$value": "{color.burnt-orange.700}"
        },
        "800": {
          "$value": "{color.burnt-orange.800}"
        },
        "900": {
          "$value": "{color.burnt-orange.900}"
        }
      },
      "accent-strong": {
        "$value": "{color.burnt-orange.600}"
      },
      "accent-strong-hover": {
        "$value": "{color.burnt-orange.hover}"
      },
      "accent-strong-pressed": {
        "$value": "{color.burnt-orange.700}"
      }
    }
  }
}
