{
  "$description": "Accent overlay 'Ochre'. Selected at runtime with <html data-accent=\"ochre\">; re-points ONLY brand.color.accent* (never neutral or feedback). Every overlay must pass the validator's WCAG AA pairs in every brand×theme.",
  "brand": {
    "color": {
      "$type": "color",
      "accent": {
        "50": {
          "$value": "{color.ochre.50}"
        },
        "100": {
          "$value": "{color.ochre.100}"
        },
        "200": {
          "$value": "{color.ochre.200}"
        },
        "300": {
          "$value": "{color.ochre.300}"
        },
        "400": {
          "$value": "{color.ochre.400}"
        },
        "500": {
          "$value": "{color.ochre.500}"
        },
        "600": {
          "$value": "{color.ochre.600}"
        },
        "700": {
          "$value": "{color.ochre.700}"
        },
        "800": {
          "$value": "{color.ochre.800}"
        },
        "900": {
          "$value": "{color.ochre.900}"
        }
      },
      "accent-strong": {
        "$value": "{color.ochre.600}"
      },
      "accent-strong-hover": {
        "$value": "{color.ochre.hover}"
      },
      "accent-strong-pressed": {
        "$value": "{color.ochre.700}"
      }
    }
  }
}
