{
  "$description": "Text input.",
  "input": {
    "background": {
      "$value": "{color.background.surface}"
    },
    "text": {
      "$value": "{color.text.primary}"
    },
    "placeholder": {
      "$value": "{color.text.tertiary}"
    },
    "border": {
      "$value": "{color.border.default}"
    },
    "border-hover": {
      "$value": "{color.border.strong}"
    },
    "border-focus": {
      "$value": "{color.border.focus}"
    },
    "radius": {
      "$value": "{shape.radius.field}"
    },
    "height": {
      "$value": "{size.control.md}"
    },
    "padding-x": {
      "$value": "{space.md}"
    },
    "font-size": {
      "$value": "{text.body.font-size}"
    },
    "disabled": {
      "background": {
        "$value": "{color.background.disabled}"
      },
      "text": {
        "$value": "{color.text.disabled}"
      }
    },
    "error": {
      "border": {
        "$value": "{color.feedback.error}"
      }
    }
  }
}
